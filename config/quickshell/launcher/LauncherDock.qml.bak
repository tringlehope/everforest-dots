import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Io
import Quickshell.Widgets
import "../components"
import ".."

Scope {
    id: root
    property bool open: false
    property string searchText: ""
    property var runningClients: []
    property var appFreq: ({})

    Process {
        id: clientsProc
        command: ["hyprctl", "clients", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    var arr = JSON.parse(text);
                    arr.sort((a, b) => (a.workspace?.id ?? 0) - (b.workspace?.id ?? 0));
                    root.runningClients = arr;
                } catch (e) {
                    root.runningClients = [];
                }
            }
        }
    }

    Process {
        id: freqRead
        command: ["sh", "-c", "cat ~/.local/state/qs-app-freq.json 2>/dev/null || echo '{}'"]
        stdout: StdioCollector {
            onStreamFinished: {
                try { root.appFreq = JSON.parse(text); } catch (e) { root.appFreq = {}; }
            }
        }
    }

    function recordLaunch(appId) {
        var f = Object.assign({}, root.appFreq);
        f[appId] = (f[appId] || 0) + 1;
        root.appFreq = f;
        var jsonStr = JSON.stringify(f).replace(/'/g, "'\\''");
        Runner.exec(["sh", "-c", "printf '%s' '" + jsonStr + "' > ~/.local/state/qs-app-freq.json"]);
    }

    onOpenChanged: {
        if (open) {
            searchText = "";
            searchInput.forceActiveFocus();
            clientsProc.running = true;
            freqRead.running = true;
        }
    }

    PanelWindow {
        visible: menuCard.scale > 0.05 || root.open
        exclusiveZone: -1
        anchors { top: true; bottom: true; left: true; right: true }
        color: "transparent"
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "qs-launcher"
        WlrLayershell.keyboardFocus: root.open ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

        MouseArea { anchors.fill: parent; onClicked: root.open = false }

        Rectangle {
            id: menuCard
            anchors.centerIn: parent
            anchors.verticalCenterOffset: root.runningClients.length > 0 ? -36 : 0
            width: 390
            height: 430
            radius: Theme.radiusCard
            color: Theme.bgSurface
            border.color: Theme.accent
            border.width: 3

            transformOrigin: Item.Center
            scale: root.open ? 1.0 : 0.0
            Behavior on scale {
                NumberAnimation {
                    duration: root.open ? 260 : 160
                    easing.type: root.open ? Easing.OutBack : Easing.InCubic
                    easing.overshoot: 1.15
                }
            }

            MouseArea { anchors.fill: parent }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 14
                spacing: 10

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 8

                    Rectangle {
                        Layout.fillWidth: true
                        implicitHeight: 38
                        radius: Theme.radiusPill
                        color: Theme.bgPill

                        RowLayout {
                            anchors.fill: parent; anchors.leftMargin: 12; anchors.rightMargin: 12; spacing: 8
                            Text { text: "\uf002"; font.family: Theme.iconFont; font.pixelSize: 13; color: Theme.fgMuted }
                            TextInput {
                                id: searchInput
                                Layout.fillWidth: true
                                text: root.searchText
                                onTextChanged: root.searchText = text
                                font.family: Theme.fontFamily; font.pixelSize: 13
                                color: Theme.fg
                                selectByMouse: true
                                Keys.onEscapePressed: root.open = false
                                Text {
                                    visible: !parent.text
                                    text: "Поиск..."
                                    font.family: Theme.fontFamily; font.pixelSize: 13
                                    color: Theme.fgMuted
                                }
                            }
                        }
                    }

                    Rectangle {
                        implicitWidth: 34; implicitHeight: 34
                        radius: closeMouse.containsMouse ? 10 : 17
                        color: closeMouse.containsMouse ? Theme.bgPillHover : Theme.bgPill
                        Behavior on radius { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }
                        Text { anchors.centerIn: parent; text: "\uf00d"; font.family: Theme.iconFont; font.pixelSize: 13; color: Theme.fgMuted }
                        MouseArea { id: closeMouse; anchors.fill: parent; hoverEnabled: true; onClicked: root.open = false }
                    }
                }

                Item {
                    Layout.fillWidth: true
                    Layout.fillHeight: true

                    ListView {
                        id: appList
                        anchors.fill: parent
                        anchors.rightMargin: 10
                        clip: true
                        spacing: 6
                        model: {
                            var q = root.searchText.toLowerCase();
                            var res = [];
                            var list = DesktopEntries.applications.values;
                            for (var i = 0; i < list.length; i++) {
                                var app = list[i];
                                if (app.noDisplay) continue;
                                if (!q || app.name.toLowerCase().indexOf(q) !== -1) res.push(app);
                            }
                            res.sort((a, b) => {
                                var fa = root.appFreq[a.id] || 0;
                                var fb = root.appFreq[b.id] || 0;
                                if (fb !== fa) return fb - fa;
                                return a.name.localeCompare(b.name);
                            });
                            return res;
                        }

                        delegate: Rectangle {
                            required property var modelData
                            width: appList.width
                            implicitHeight: 44
                            radius: appMouse.containsMouse ? 10 : 22
                            color: appMouse.containsMouse ? Theme.bgPillHover : Theme.bgPill
                            Behavior on radius { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }

                            RowLayout {
                                anchors.fill: parent; anchors.leftMargin: 12; anchors.rightMargin: 12; spacing: 10
                                IconImage {
                                    source: Quickshell.iconPath(modelData.icon, "application-x-executable")
                                    implicitSize: 24
                                }
                                Text {
                                    Layout.fillWidth: true
                                    text: modelData.name
                                    font.family: Theme.fontFamily; font.pixelSize: 13; font.weight: Font.Medium
                                    color: Theme.fg
                                    elide: Text.ElideRight
                                }
                            }

                            MouseArea {
                                id: appMouse
                                anchors.fill: parent; hoverEnabled: true
                                onClicked: {
                                    var appId = modelData.id;
                                    modelData.execute(); root.open = false; root.recordLaunch(appId);
                                    root.open = false;
                                }
                            }
                        }
                    }

                    Canvas {
                        id: scrollWave
                        visible: appList.contentHeight > appList.height
                        anchors { right: parent.right; top: parent.top; bottom: parent.bottom }
                        width: 6
                        property real pos: appList.visibleArea.yPosition
                        property real ratio: appList.visibleArea.heightRatio
                        onPosChanged: requestPaint()
                        onRatioChanged: requestPaint()
                        onPaint: {
                            var ctx = getContext("2d");
                            ctx.reset();
                            var y1 = Math.max(4, pos * height);
                            var h = Math.max(24, ratio * height);
                            var y2 = Math.min(height - 4, y1 + h);
                            ctx.strokeStyle = Theme.accent;
                            ctx.lineWidth = 3;
                            ctx.lineCap = "round";
                            ctx.beginPath();
                            for (var y = y1; y <= y2; y += 2) {
                                var x = width / 2 + Math.sin(y * 0.35) * 1.6;
                                if (y === y1) ctx.moveTo(x, y);
                                else ctx.lineTo(x, y);
                            }
                            ctx.stroke();
                        }
                    }
                }

                Rectangle {
                    Layout.fillWidth: true
                    implicitHeight: 36
                    radius: updMouse.containsMouse ? 10 : 18
                    color: updMouse.containsMouse ? Theme.bgPillHover : Theme.bgElevated
                    border.color: Theme.borderSubtle
                    border.width: 1
                    Behavior on radius { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }

                    RowLayout {
                        anchors.centerIn: parent; spacing: 8
                        Text { text: "\uf021"; font.family: Theme.iconFont; font.pixelSize: 12; color: Theme.accent }
                        Text { text: "Обновить софт"; font.family: Theme.fontFamily; font.pixelSize: 12; font.weight: Font.DemiBold; color: Theme.fg }
                    }
                    MouseArea { id: updMouse; anchors.fill: parent; hoverEnabled: true; onClicked: console.log("Update stub") }
                }
            }
        }

        Rectangle {
            id: dockCard
            visible: root.runningClients.length > 0
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            anchors.bottomMargin: Theme.frameThickness + 8
            width: Math.max(64, dockRow.implicitWidth + 24)
            height: 56
            radius: Theme.radiusPill
            color: Theme.bgSurface
            border.color: Theme.accent
            border.width: 3

            transformOrigin: Item.Bottom
            scale: root.open ? 1.0 : 0.0
            Behavior on scale {
                NumberAnimation {
                    duration: root.open ? 280 : 160
                    easing.type: root.open ? Easing.OutBack : Easing.InCubic
                    easing.overshoot: 1.15
                }
            }

            MouseArea { anchors.fill: parent }

            RowLayout {
                id: dockRow
                anchors.centerIn: parent
                spacing: 10

                Repeater {
                    model: root.runningClients
                    delegate: Rectangle {
                        required property var modelData
                        width: 42; height: 42
                        radius: dockItemMouse.containsMouse ? 10 : 21
                        color: dockItemMouse.containsMouse ? Theme.bgPillHover : Theme.bgPill
                        Behavior on radius { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }

                        IconImage {
                            anchors.centerIn: parent
                            source: Quickshell.iconPath((modelData.class || "").toLowerCase(), "application-x-executable")
                            implicitSize: 24
                        }

                        Rectangle {
                            anchors { right: parent.right; bottom: parent.bottom }
                            width: 16; height: 16; radius: 8
                            color: Theme.accentWarm
                            Text {
                                anchors.centerIn: parent
                                text: String(modelData.workspace?.id ?? "")
                                font.family: Theme.fontFamily; font.pixelSize: 9; font.weight: Font.Bold; color: Theme.accentOn
                            }
                        }

                        MouseArea {
                            id: dockItemMouse
                            anchors.fill: parent; hoverEnabled: true
                            onClicked: {
                                Runner.exec(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = " + (modelData.workspace?.id ?? 1) + " })"]);
                                root.open = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
